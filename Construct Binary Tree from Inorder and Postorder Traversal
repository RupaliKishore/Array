Construct Binary Tree from Inorder and Postorder Traversal




/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    private Map<Integer, Integer> inorderMap;
    private int postorderIndex;
    
    public TreeNode buildTree(int[] inorder, int[] postorder) {
        // Create a map to quickly find index of any value in inorder array
        inorderMap = new HashMap<>();
        for (int i = 0; i < inorder.length; i++) {
            inorderMap.put(inorder[i], i);
        }
        
        // Start from the last element in postorder (root)
        postorderIndex = postorder.length - 1;
        
        return buildTreeHelper(postorder, 0, inorder.length - 1);
    }
    
    private TreeNode buildTreeHelper(int[] postorder, int inorderStart, int inorderEnd) {
        // Base case: no elements to process
        if (inorderStart > inorderEnd) {
            return null;
        }
        
        // Get current root value from postorder (last element in current range)
        int rootVal = postorder[postorderIndex--];
        TreeNode root = new TreeNode(rootVal);
        
        // Find index of root in inorder traversal
        int inorderIndex = inorderMap.get(rootVal);
        
        // Build right subtree first (because postorder processes left, right, root)
        // We need to build right before left since we're going backwards through postorder
        root.right = buildTreeHelper(postorder, inorderIndex + 1, inorderEnd);
        root.left = buildTreeHelper(postorder, inorderStart, inorderIndex - 1);
        
        return root;
    }
}
