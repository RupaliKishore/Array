Non-decreasing Array



class Solution {
    public boolean checkPossibility(int[] nums) {
        int count = 0; // Number of modifications needed
        
        for (int i = 0; i < nums.length - 1; i++) {
            if (nums[i] > nums[i + 1]) {
                count++;
                
                // If more than one modification needed, return false
                if (count > 1) {
                    return false;
                }
                
                // Decide which value to modify
                if (i > 0 && nums[i - 1] > nums[i + 1]) {
                    // Modify nums[i+1] to be larger
                    nums[i + 1] = nums[i];
                } else {
                    // Modify nums[i] to be smaller
                    nums[i] = nums[i + 1];
                }
            }
        }
        
        return true;
    }
}
