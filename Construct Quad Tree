Construct Quad Tree



class Solution {
    public Node construct(int[][] grid) {
        return build(grid, 0, 0, grid.length);
    }
    
    private Node build(int[][] grid, int row, int col, int size) {
        // Check if current segment is uniform (all same value)
        if (isUniform(grid, row, col, size)) {
            return new Node(grid[row][col] == 1, true);
        }
        
        // Divide into 4 quadrants
        int halfSize = size / 2;
        
        Node topLeft = build(grid, row, col, halfSize);
        Node topRight = build(grid, row, col + halfSize, halfSize);
        Node bottomLeft = build(grid, row + halfSize, col, halfSize);
        Node bottomRight = build(grid, row + halfSize, col + halfSize, halfSize);
        
        return new Node(true, false, topLeft, topRight, bottomLeft, bottomRight);
    }
    
    private boolean isUniform(int[][] grid, int row, int col, int size) {
        int firstValue = grid[row][col];
        for (int i = row; i < row + size; i++) {
            for (int j = col; j < col + size; j++) {
                if (grid[i][j] != firstValue) {
                    return false;
                }
            }
        }
        return true;
    }
}
