Longest Subarray of 1's After Deleting One Element



class Solution {
    public int longestSubarray(int[] nums) {
        int left = 0;
        int zerosCount = 0;
        int maxLength = 0;
        
        for (int right = 0; right < nums.length; right++) {
            // Count zeros in current window
            if (nums[right] == 0) {
                zerosCount++;
            }
            
            // If more than 1 zero, shrink window from left
            while (zerosCount > 1) {
                if (nums[left] == 0) {
                    zerosCount--;
                }
                left++;
            }
            
            // Window is valid (at most 1 zero)
            // We must delete one element, so subtract 1 from window size
            // But if window has no zeros, we still delete one 1
            maxLength = Math.max(maxLength, right - left);
        }
        
        return maxLength;
    }
}
