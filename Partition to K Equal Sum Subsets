Partition to K Equal Sum Subsets



class Solution {
    public boolean canPartitionKSubsets(int[] nums, int k) {
        int sum = 0;
        for (int num : nums) {
            sum += num;
        }
        
        // If total sum not divisible by k, impossible
        if (sum % k != 0) return false;
        
        int target = sum / k;
        
        // Sort in descending order to prune early
        Arrays.sort(nums);
        reverse(nums);
        
        // If largest number > target, impossible
        if (nums[0] > target) return false;
        
        boolean[] used = new boolean[nums.length];
        return backtrack(nums, used, k, 0, 0, target);
    }
    
    private boolean backtrack(int[] nums, boolean[] used, int k, int start, 
                              int currentSum, int target) {
        // All subsets formed successfully
        if (k == 0) return true;
        
        // Current subset reached target, start next subset
        if (currentSum == target) {
            return backtrack(nums, used, k - 1, 0, 0, target);
        }
        
        // Try to add numbers to current subset
        for (int i = start; i < nums.length; i++) {
            if (!used[i] && currentSum + nums[i] <= target) {
                used[i] = true;
                if (backtrack(nums, used, k, i + 1, currentSum + nums[i], target)) {
                    return true;
                }
                used[i] = false;
                
                // Pruning: If currentSum is 0, first number failed, no solution
                if (currentSum == 0) return false;
                
                // Pruning: Skip duplicates
                while (i + 1 < nums.length && nums[i + 1] == nums[i]) {
                    i++;
                }
            }
        }
        return false;
    }
    
    private void reverse(int[] nums) {
        int left = 0, right = nums.length - 1;
        while (left < right) {
            int temp = nums[left];
            nums[left] = nums[right];
            nums[right] = temp;
            left++;
            right--;
        }
    }
}
