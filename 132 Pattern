132 Pattern



class Solution {
    public boolean find132pattern(int[] nums) {
        if (nums == null || nums.length < 3) {
            return false;
        }
        
        Stack<Integer> stack = new Stack<>();
        int second = Integer.MIN_VALUE;  // This will store the '2' value (nums[k])
        
        // Traverse from right to left
        for (int i = nums.length - 1; i >= 0; i--) {
            if (nums[i] < second) {
                // Found a '1' that is less than '2'
                return true;
            }
            
            // Maintain stack in decreasing order
            while (!stack.isEmpty() && nums[i] > stack.peek()) {
                second = stack.pop();  // This becomes the '2'
            }
            
            stack.push(nums[i]);  // This becomes potential '3'
        }
        
        return false;
    }
}
