Escape The Ghosts


class Solution {
    public boolean escapeGhosts(int[][] ghosts, int[] target) {
        // Calculate your distance to target (Manhattan distance)
        int yourDistance = Math.abs(target[0]) + Math.abs(target[1]);
        
        // Check each ghost
        for (int[] ghost : ghosts) {
            // Calculate ghost's distance to target
            int ghostDistance = Math.abs(ghost[0] - target[0]) + Math.abs(ghost[1] - target[1]);
            
            // If ghost can reach target at or before you, you cannot escape
            if (ghostDistance <= yourDistance) {
                return false;
            }
        }
        
        // If no ghost can reach target before you, you can escape
        return true;
    }
}
