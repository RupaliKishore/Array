  Calculate Maximum Information Gain



import java.util.*;

class Solution {
    
    /**
     * Calculate entropy of a group of species
     */
    private double calculateEntropy(List<String> species) {
        if (species == null || species.isEmpty()) {
            return 0.0;
        }
        
        Map<String, Integer> freq = new HashMap<>();
        for (String s : species) {
            freq.put(s, freq.getOrDefault(s, 0) + 1);
        }
        
        double entropy = 0.0;
        int total = species.size();
        for (int count : freq.values()) {
            double p = (double) count / total;
            entropy -= p * (Math.log(p) / Math.log(2));
        }
        
        return entropy;
    }
    
    /**
     * Calculate information gain from a split
     */
    private double calculateInformationGain(List<String> allSpecies, 
                                            List<String> leftSpecies, 
                                            List<String> rightSpecies) {
        double parentEntropy = calculateEntropy(allSpecies);
        
        double leftWeight = (double) leftSpecies.size() / allSpecies.size();
        double rightWeight = (double) rightSpecies.size() / allSpecies.size();
        
        double weightedChildEntropy = leftWeight * calculateEntropy(leftSpecies) +
                                      rightWeight * calculateEntropy(rightSpecies);
        
        return parentEntropy - weightedChildEntropy;
    }
    
    /**
     * Calculate maximum information gain
     * @param petalLength Array of petal lengths (double type)
     * @param species Array of species names
     * @return Maximum information gain
     */
    public double calculateMaxInfoGain(double[] petalLength, String[] species) {
        if (petalLength == null || species == null || petalLength.length == 0) {
            return 0.0;
        }
        
        int n = petalLength.length;
        
        // Create array of indices and sort by petal_length
        Integer[] indices = new Integer[n];
        for (int i = 0; i < n; i++) {
            indices[i] = i;
        }
        
        // Sort indices based on petal_length (ascending)
        Arrays.sort(indices, (a, b) -> Double.compare(petalLength[a], petalLength[b]));
        
        // Create sorted species list based on sorted indices
        List<String> sortedSpecies = new ArrayList<>();
        for (int idx : indices) {
            sortedSpecies.add(species[idx]);
        }
        
        double maxGain = 0.0;
        
        // Try all possible split points (between elements)
        // Split from 1 to n-1 to ensure both groups are non-empty
        for (int splitPoint = 1; splitPoint < n; splitPoint++) {
            List<String> leftGroup = new ArrayList<>(sortedSpecies.subList(0, splitPoint));
            List<String> rightGroup = new ArrayList<>(sortedSpecies.subList(splitPoint, n));
            
            double gain = calculateInformationGain(sortedSpecies, leftGroup, rightGroup);
            
            if (gain > maxGain) {
                maxGain = gain;
            }
        }
        
        return maxGain;
    }
}
