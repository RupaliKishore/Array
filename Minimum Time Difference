Minimum Time Difference




import java.util.*;

class Solution {

    public int findMinDifference(List<String> timePoints) {

        // If more than 1440 time points, duplicate must exist
        if (timePoints.size() > 1440) {
            return 0;
        }

        List<Integer> minutesList = new ArrayList<>();

        // Convert HH:MM to total minutes
        for (String time : timePoints) {

            String[] parts = time.split(":");

            int hours = Integer.parseInt(parts[0]);
            int minutes = Integer.parseInt(parts[1]);

            minutesList.add(hours * 60 + minutes);
        }

        // Sort the list
        Collections.sort(minutesList);

        int minDiff = Integer.MAX_VALUE;

        // Find minimum difference between adjacent times
        for (int i = 1; i < minutesList.size(); i++) {

            minDiff = Math.min(
                minDiff,
                minutesList.get(i) - minutesList.get(i - 1)
            );
        }

        // Check circular difference (last -> first across midnight)
        int circularDiff =
            1440 - minutesList.get(minutesList.size() - 1)
            + minutesList.get(0);

        minDiff = Math.min(minDiff, circularDiff);

        return minDiff;
    }
}
