Set Intersection Size At Least Two



class Solution {
    public int intersectionSizeTwo(int[][] intervals) {
        // Sort by end ascending, then start descending
        Arrays.sort(intervals, (a, b) -> {
            if (a[1] != b[1]) return a[1] - b[1];
            return b[0] - a[0];
        });
        
        // Store chosen points
        List<Integer> points = new ArrayList<>();
        
        for (int[] interval : intervals) {
            int start = interval[0];
            int end = interval[1];
            
            // Count how many chosen points are in this interval
            int count = 0;
            for (int i = points.size() - 1; i >= 0 && points.get(i) >= start; i--) {
                count++;
                if (count >= 2) break;
            }
            
            if (count == 0) {
                // Need to add last two numbers of the interval
                points.add(end - 1);
                points.add(end);
            } else if (count == 1) {
                // Need one more number
                points.add(end);
            }
            // count == 2: already covered
        }
        
        return points.size();
    }
}
