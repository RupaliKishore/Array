Continuous Subarray Sum




import java.util.*;

class Solution {
    public boolean checkSubarraySum(int[] nums, int k) {
        // Map remainder -> earliest index where this remainder occurred
        Map<Integer, Integer> remainderMap = new HashMap<>();
        
        // Handle case where subarray starts from index 0
        remainderMap.put(0, -1);
        
        int prefixSum = 0;
        
        for (int i = 0; i < nums.length; i++) {
            prefixSum += nums[i];
            
            // Handle k = 0 case
            int remainder = (k == 0) ? prefixSum : prefixSum % k;
            
            if (remainderMap.containsKey(remainder)) {
                // Check if subarray length is at least 2
                if (i - remainderMap.get(remainder) >= 2) {
                    return true;
                }
            } else {
                // Only store first occurrence of each remainder
                remainderMap.put(remainder, i);
            }
        }
        
        return false;
    }
}
