Beautiful Arrangement II


class Solution {
    public int[] constructArray(int n, int k) {
        int[] result = new int[n];
        int left = 1;
        int right = n;
        
        // Build pattern: 1, n, 2, n-1, 3, n-2, ... (creates decreasing differences)
        for (int i = 0; i < n; i++) {
            if (k > 1) {
                // Use alternating ends to create large differences
                if (k % 2 == 0) {
                    result[i] = right--;
                } else {
                    result[i] = left++;
                }
                k--;
            } else {
                // Fill remaining with consecutive numbers
                result[i] = left++;
            }
        }
        
        return result;
    }
}
