Contiguous Array



import java.util.*;

class Solution {
    public int findMaxLength(int[] nums) {
        // Map sum -> first occurrence index
        Map<Integer, Integer> map = new HashMap<>();
        map.put(0, -1); // Base case: sum 0 before starting
        
        int maxLen = 0;
        int sum = 0;
        
        for (int i = 0; i < nums.length; i++) {
            // Treat 0 as -1, 1 as 1
            sum += (nums[i] == 0) ? -1 : 1;
            
            if (map.containsKey(sum)) {
                // Subarray from map.get(sum)+1 to i has equal 0s and 1s
                maxLen = Math.max(maxLen, i - map.get(sum));
            } else {
                // Store first occurrence of this sum
                map.put(sum, i);
            }
        }
        
        return maxLen;
    }
}
