 Reduction Operations to Make the Array Elements Equal



import java.util.*;

class Solution {
    public int reductionOperations(int[] nums) {
        // Sort the array in ascending order
        Arrays.sort(nums);
        
        int operations = 0;
        int steps = 0;
        
        // Traverse from the end to beginning
        for (int i = 1; i < nums.length; i++) {
            if (nums[i] != nums[i - 1]) {
                steps++;
            }
            operations += steps;
        }
        
        return operations;
    }
}
