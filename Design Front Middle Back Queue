Design Front Middle Back Queue



class FrontMiddleBackQueue {
    private Deque<Integer> left;
    private Deque<Integer> right;
    
    public FrontMiddleBackQueue() {
        left = new ArrayDeque<>();
        right = new ArrayDeque<>();
    }
    
    // Rebalance to maintain: left.size() == right.size() OR left.size() == right.size() + 1
    private void rebalance() {
        // Left should have at most 1 more element than right
        while (left.size() > right.size() + 1) {
            right.addFirst(left.removeLast());
        }
        // Right should not have more elements than left
        while (right.size() > left.size()) {
            left.addLast(right.removeFirst());
        }
    }
    
    public void pushFront(int val) {
        left.addFirst(val);
        rebalance();
    }
    
    public void pushMiddle(int val) {
        // Add to left or right based on current sizes
        if (left.size() > right.size()) {
            right.addFirst(left.removeLast());
        }
        left.addLast(val);
        rebalance();
    }
    
    public void pushBack(int val) {
        right.addLast(val);
        rebalance();
    }
    
    public int popFront() {
        if (left.isEmpty() && right.isEmpty()) {
            return -1;
        }
        
        int val;
        if (!left.isEmpty()) {
            val = left.removeFirst();
        } else {
            val = right.removeFirst();
        }
        rebalance();
        return val;
    }
    
    public int popMiddle() {
        if (left.isEmpty() && right.isEmpty()) {
            return -1;
        }
        
        int val;
        if (left.size() == right.size()) {
            val = left.removeLast();
        } else {
            val = left.removeLast();
        }
        rebalance();
        return val;
    }
    
    public int popBack() {
        if (left.isEmpty() && right.isEmpty()) {
            return -1;
        }
        
        int val;
        if (!right.isEmpty()) {
            val = right.removeLast();
        } else {
            val = left.removeLast();
        }
        rebalance();
        return val;
    }
}
