 Repeated String Match

 



class Solution {
    public int repeatedStringMatch(String a, String b) {
        StringBuilder sb = new StringBuilder();
        int count = 0;
        
        // Repeat until length is at least b's length
        while (sb.length() < b.length()) {
            sb.append(a);
            count++;
        }
        
        // Check if b is a substring
        if (sb.indexOf(b) != -1) {
            return count;
        }
        
        // Try one more repetition (edge case for overlapping)
        sb.append(a);
        count++;
        
        if (sb.indexOf(b) != -1) {
            return count;
        }
        
        return -1;
    }
}
