Maximum Sum of 3 Non-Overlapping Subarrays



class Solution {
    public int[] maxSumOfThreeSubarrays(int[] nums, int k) {
        int n = nums.length;
        
        // Compute sums of all subarrays of length k
        int[] sums = new int[n - k + 1];
        int windowSum = 0;
        for (int i = 0; i < n; i++) {
            windowSum += nums[i];
            if (i >= k - 1) {
                sums[i - k + 1] = windowSum;
                windowSum -= nums[i - k + 1];
            }
        }
        
        // left[i] = best starting index for 1 subarray in sums[0..i]
        int[] left = new int[sums.length];
        int bestIndex = 0;
        for (int i = 0; i < sums.length; i++) {
            if (sums[i] > sums[bestIndex]) {
                bestIndex = i;
            }
            left[i] = bestIndex;
        }
        
        // right[i] = best starting index for 1 subarray in sums[i..end]
        int[] right = new int[sums.length];
        bestIndex = sums.length - 1;
        for (int i = sums.length - 1; i >= 0; i--) {
            if (sums[i] >= sums[bestIndex]) {
                bestIndex = i;
            }
            right[i] = bestIndex;
        }
        
        // Try all possible middle subarray positions
        int[] result = new int[3];
        int maxSum = 0;
        for (int mid = k; mid < sums.length - k; mid++) {
            int leftIndex = left[mid - k];
            int rightIndex = right[mid + k];
            int total = sums[leftIndex] + sums[mid] + sums[rightIndex];
            if (total > maxSum) {
                maxSum = total;
                result[0] = leftIndex;
                result[1] = mid;
                result[2] = rightIndex;
            }
        }
        
        return result;
    }
}
