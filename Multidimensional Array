 Multidimensional Array



 // 2D array declaration
int[][] matrix = new int[3][3];

// Assigning values
matrix[0][0] = 1;
matrix[0][1] = 2;
matrix[1][0] = 3;
matrix[1][1] = 4;

// 2D array literal
int[][] predefined = {
    {1, 2, 3},
    {4, 5, 6},
    {7, 8, 9}
};

// Ragged array (different row lengths)
int[][] ragged = new int[3][];
ragged[0] = new int[2];
ragged[1] = new int[4];
ragged[2] = new int[3];
