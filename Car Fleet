Car Fleet


import java.util.*;

class Car {
    int position;
    int speed;
    
    Car(int position, int speed) {
        this.position = position;
        this.speed = speed;
    }
}

class Solution {
    public int carFleet(int target, int[] position, int[] speed) {
        int n = position.length;
        if (n == 0) return 0;
        
        // Create array of cars
        Car[] cars = new Car[n];
        for (int i = 0; i < n; i++) {
            cars[i] = new Car(position[i], speed[i]);
        }
        
        // Sort cars by position (descending order - from closest to target to farthest)
        Arrays.sort(cars, (a, b) -> b.position - a.position);
        
        // Stack to keep track of times each car takes to reach target
        Stack<Double> stack = new Stack<>();
        
        for (Car car : cars) {
            // Calculate time to reach target
            double time = (double)(target - car.position) / car.speed;
            
            // If current car takes longer than the car ahead, it won't catch up
            // So it forms a new fleet
            if (stack.isEmpty() || time > stack.peek()) {
                stack.push(time);
            }
            // Otherwise, it will catch up and join the fleet ahead
        }
        
        return stack.size();
    }
}
