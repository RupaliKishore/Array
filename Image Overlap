Image Overlap


import java.util.*;

class Solution {
    public int largestOverlap(int[][] img1, int[][] img2) {
        int n = img1.length;
        
        // Store positions of 1's in both images
        List<int[]> ones1 = new ArrayList<>();
        List<int[]> ones2 = new ArrayList<>();
        
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (img1[i][j] == 1) {
                    ones1.add(new int[]{i, j});
                }
                if (img2[i][j] == 1) {
                    ones2.add(new int[]{i, j});
                }
            }
        }
        
        // Count frequency of each translation vector
        Map<String, Integer> vectorCount = new HashMap<>();
        
        for (int[] p1 : ones1) {
            for (int[] p2 : ones2) {
                // Translation vector: p2 - p1
                int dx = p2[0] - p1[0];
                int dy = p2[1] - p1[1];
                String key = dx + "," + dy;
                vectorCount.put(key, vectorCount.getOrDefault(key, 0) + 1);
            }
        }
        
        // Find maximum count
        int maxOverlap = 0;
        for (int count : vectorCount.values()) {
            maxOverlap = Math.max(maxOverlap, count);
        }
        
        return maxOverlap;
    }
}
