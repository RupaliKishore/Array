Longest Uncommon Subsequence II




import java.util.*;

class Solution {
    public int findLUSlength(String[] strs) {
        int n = strs.length;
        int maxLen = -1;
        
        // Compare each string with every other string
        for (int i = 0; i < n; i++) {
            boolean isSubsequenceOfAnother = false;
            
            for (int j = 0; j < n; j++) {
                if (i != j && isSubsequence(strs[i], strs[j])) {
                    isSubsequenceOfAnother = true;
                    break;
                }
            }
            
            // If current string is not a subsequence of any other string
            if (!isSubsequenceOfAnother) {
                maxLen = Math.max(maxLen, strs[i].length());
            }
        }
        
        return maxLen;
    }
    
    // Helper method to check if s1 is a subsequence of s2
    private boolean isSubsequence(String s1, String s2) {
        if (s1.length() > s2.length()) return false;
        
        int i = 0, j = 0;
        while (i < s1.length() && j < s2.length()) {
            if (s1.charAt(i) == s2.charAt(j)) {
                i++;
            }
            j++;
        }
        return i == s1.length();
    }
}
