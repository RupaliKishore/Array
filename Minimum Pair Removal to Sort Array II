Minimum Pair Removal to Sort Array II



import java.util.*;

class Solution {
    class Node {
        long val;
        Node prev;
        Node next;
        
        Node(long val) {
            this.val = val;
        }
    }
    
    class Pair {
        long sum;
        int index;
        
        Pair(long sum, int index) {
            this.sum = sum;
            this.index = index;
        }
    }
    
    public int minimumPairRemoval(int[] nums) {
        int n = nums.length;
        if (n <= 1) return 0;
        
        // Create doubly linked list
        Node head = new Node(nums[0]);
        Node tail = head;
        for (int i = 1; i < n; i++) {
            Node newNode = new Node(nums[i]);
            tail.next = newNode;
            newNode.prev = tail;
            tail = newNode;
        }
        
        // Min-heap of pairs (sum, node_index)
        PriorityQueue<Pair> pq = new PriorityQueue<>((a, b) -> {
            if (a.sum != b.sum) return Long.compare(a.sum, b.sum);
            return Integer.compare(a.index, b.index);
        });
        
        // Track current sums
        Map<Node, Long> sumMap = new HashMap<>();
        Node curr = head;
        int index = 0;
        while (curr != null && curr.next != null) {
            long sum = curr.val + curr.next.val;
            sumMap.put(curr, sum);
            pq.offer(new Pair(sum, index));
            curr = curr.next;
            index++;
        }
        
        int operations = 0;
        boolean[] removed = new boolean[n];
        
        while (!isNonDecreasing(head)) {
            // Find min sum pair
            Pair best = null;
            while (!pq.isEmpty()) {
                Pair p = pq.poll();
                // Verify if this pair is still valid
                if (p.index < n && !removed[p.index]) {
                    best = p;
                    break;
                }
            }
            
            if (best == null) break;
            
            // Find the nodes at this index
            Node node = head;
            int idx = 0;
            while (idx < best.index && node != null) {
                node = node.next;
                idx++;
            }
            
            if (node == null || node.next == null) continue;
            
            // Merge node and node.next
            long newVal = node.val + node.next.val;
            node.val = newVal;
            
            // Remove node.next
            Node toRemove = node.next;
            node.next = toRemove.next;
            if (toRemove.next != null) {
                toRemove.next.prev = node;
            }
            removed[best.index + 1] = true;
            
            operations++;
            
            // Update sums for affected pairs
            // Previous pair (node.prev, node)
            if (node.prev != null) {
                long newSum = node.prev.val + node.val;
                sumMap.put(node.prev, newSum);
                // Find index of node.prev
                Node temp = head;
                int prevIdx = 0;
                while (temp != node.prev) {
                    temp = temp.next;
                    prevIdx++;
                }
                pq.offer(new Pair(newSum, prevIdx));
            }
            
            // Current pair (node, node.next)
            if (node.next != null) {
                long newSum = node.val + node.next.val;
                sumMap.put(node, newSum);
                pq.offer(new Pair(newSum, best.index));
            }
        }
        
        return operations;
    }
    
    private boolean isNonDecreasing(Node head) {
        Node curr = head;
        while (curr != null && curr.next != null) {
            if (curr.val > curr.next.val) {
                return false;
            }
            curr = curr.next;
        }
        return true;
    }
}
