 Sliding Puzzle



class Solution {
    public int slidingPuzzle(int[][] board) {
        // Target state as string
        String target = "123450";
        
        // Convert board to string
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 3; j++) {
                sb.append(board[i][j]);
            }
        }
        String start = sb.toString();
        
        // If already at target
        if (start.equals(target)) return 0;
        
        // Neighbor mappings for each position (index in 1D string)
        // 2x3 board flattened: positions 0-5
        // 0 1 2
        // 3 4 5
        int[][] neighbors = {
            {1, 3},        // position 0 can swap with 1, 3
            {0, 2, 4},     // position 1 can swap with 0, 2, 4
            {1, 5},        // position 2 can swap with 1, 5
            {0, 4},        // position 3 can swap with 0, 4
            {1, 3, 5},     // position 4 can swap with 1, 3, 5
            {2, 4}         // position 5 can swap with 2, 4
        };
        
        // BFS
        Queue<String> queue = new LinkedList<>();
        Set<String> visited = new HashSet<>();
        
        queue.offer(start);
        visited.add(start);
        
        int moves = 0;
        
        while (!queue.isEmpty()) {
            int size = queue.size();
            
            for (int i = 0; i < size; i++) {
                String current = queue.poll();
                
                // Check if we reached target
                if (current.equals(target)) {
                    return moves;
                }
                
                // Find position of '0'
                int zeroPos = current.indexOf('0');
                
                // Try all possible swaps
                for (int neighbor : neighbors[zeroPos]) {
                    char[] chars = current.toCharArray();
                    // Swap zero with neighbor
                    char temp = chars[zeroPos];
                    chars[zeroPos] = chars[neighbor];
                    chars[neighbor] = temp;
                    
                    String next = new String(chars);
                    
                    if (!visited.contains(next)) {
                        visited.add(next);
                        queue.offer(next);
                    }
                }
            }
            moves++;
        }
        
        return -1; // No solution (should not happen for valid puzzle)
    }
}
