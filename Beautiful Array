Beautiful Array




import java.util.*;

class Solution {
    public int[] beautifulArray(int n) {
        List<Integer> result = buildBeautifulArray(n);
        return result.stream().mapToInt(i -> i).toArray();
    }
    
    private List<Integer> buildBeautifulArray(int n) {
        List<Integer> result = new ArrayList<>();
        if (n == 1) {
            result.add(1);
            return result;
        }
        
        // Build beautiful arrays for odd and even parts
        List<Integer> odd = buildBeautifulArray((n + 1) / 2);
        List<Integer> even = buildBeautifulArray(n / 2);
        
        // Transform: odd numbers map to 2*x - 1, even numbers map to 2*x
        for (int num : odd) {
            result.add(2 * num - 1);
        }
        for (int num : even) {
            result.add(2 * num);
        }
        
        return result;
    }
}
