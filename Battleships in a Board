Battleships in a Board



class Solution {
    public int countBattleships(char[][] board) {
        if (board == null || board.length == 0) {
            return 0;
        }
        
        int m = board.length;
        int n = board[0].length;
        int count = 0;
        
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (board[i][j] == 'X') {
                    // Check if this is the start of a battleship
                    // A cell is start if there's no 'X' above or to the left
                    boolean noTop = (i == 0 || board[i-1][j] != 'X');
                    boolean noLeft = (j == 0 || board[i][j-1] != 'X');
                    
                    if (noTop && noLeft) {
                        count++;
                    }
                }
            }
        }
        
        return count;
    }
}
