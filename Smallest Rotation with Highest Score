Smallest Rotation with Highest Score




class Solution {
    public int bestRotation(int[] nums) {
        int n = nums.length;
        int[] change = new int[n];
        
        for (int i = 0; i < n; i++) {
            int val = nums[i];
            if (val >= n) continue;
            
            // The rotation that makes nums[i] at index 0
            int start = (i + 1) % n;
            // The rotation that makes nums[i] at index val
            int end = (i - val + n + 1) % n;
            
            change[start]++;
            change[end]--;
            
            if (start > end) {
                change[0]++;
            }
        }
        
        int maxScore = 0;
        int bestK = 0;
        int currentScore = 0;
        
        for (int k = 0; k < n; k++) {
            currentScore += change[k];
            if (currentScore > maxScore) {
                maxScore = currentScore;
                bestK = k;
            }
        }
        
        return bestK;
    }
}
