Number of Longest Increasing Subsequence



class Solution {
    public int findNumberOfLIS(int[] nums) {
        int n = nums.length;
        if (n == 0) return 0;
        
        // length[i] = length of LIS ending at i
        int[] length = new int[n];
        // count[i] = number of LIS ending at i with that length
        int[] count = new int[n];
        
        int maxLen = 1;
        
        for (int i = 0; i < n; i++) {
            length[i] = 1;
            count[i] = 1;
            
            for (int j = 0; j < i; j++) {
                if (nums[j] < nums[i]) {
                    if (length[j] + 1 > length[i]) {
                        length[i] = length[j] + 1;
                        count[i] = count[j];
                    } else if (length[j] + 1 == length[i]) {
                        count[i] += count[j];
                    }
                }
            }
            maxLen = Math.max(maxLen, length[i]);
        }
        
        // Sum up all counts with length == maxLen
        int result = 0;
        for (int i = 0; i < n; i++) {
            if (length[i] == maxLen) {
                result += count[i];
            }
        }
        
        return result;
    }
}
