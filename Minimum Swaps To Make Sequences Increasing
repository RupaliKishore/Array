Minimum Swaps To Make Sequences Increasing



class Solution {
    public int minSwap(int[] nums1, int[] nums2) {
        int n = nums1.length;
        
        // dp[i][0] = min swaps to make arrays increasing up to i, without swapping at i
        // dp[i][1] = min swaps to make arrays increasing up to i, with swapping at i
        int[][] dp = new int[n][2];
        
        // Base case
        dp[0][0] = 0; // No swap at index 0
        dp[0][1] = 1; // Swap at index 0
        
        for (int i = 1; i < n; i++) {
            // Initialize with large values
            dp[i][0] = Integer.MAX_VALUE;
            dp[i][1] = Integer.MAX_VALUE;
            
            // Case 1: No swap at i
            if (nums1[i] > nums1[i-1] && nums2[i] > nums2[i-1]) {
                // Valid if we didn't swap at i-1
                dp[i][0] = Math.min(dp[i][0], dp[i-1][0]);
            }
            if (nums1[i] > nums2[i-1] && nums2[i] > nums1[i-1]) {
                // Valid if we swapped at i-1
                dp[i][0] = Math.min(dp[i][0], dp[i-1][1]);
            }
            
            // Case 2: Swap at i
            if (nums2[i] > nums1[i-1] && nums1[i] > nums2[i-1]) {
                // Valid if we didn't swap at i-1
                dp[i][1] = Math.min(dp[i][1], dp[i-1][0] + 1);
            }
            if (nums2[i] > nums2[i-1] && nums1[i] > nums1[i-1]) {
                // Valid if we swapped at i-1
                dp[i][1] = Math.min(dp[i][1], dp[i-1][1] + 1);
            }
        }
        
        return Math.min(dp[n-1][0], dp[n-1][1]);
    }
}
